---
source: crates/egui_mcp/src/tools.rs
expression: surface
---
# Server instructions

This MCP drives a live egui app: it reads the app's accessibility tree and synthesizes real input. Work in an observe → act → verify loop.

- Call `attach` first; the other tools return "no app connected" until then.
- Observe with `widget_tree` (widgets and their ids) and `screenshot`.
- Target widgets by `id`, `role` or a text match rather than a raw `pos`: a locator follows the widget when the layout moves.
- Match text with `content_contains`, which checks `label` and `value`. Many widgets, such as `Label`, carry their text in `value`, so `label_contains` alone misses them.
- An action's locator must match exactly one widget; on several, the error lists them.
- After an action, verify with `widget_tree`, `screenshot`, or `wait_for` for UI that settles over time. `batch` acts and observes in one round trip.
- Everything is in logical points: `pos`, `bounds`, `resize`, and a default `screenshot`, whose pixels are logical points.

# Tools

## attach

{
  "name": "attach",
  "title": "Attach to app",
  "description": "Connect to a running egui app's inspection port (eframe's `inspection` feature, launched with `EGUI_INSPECTION` set), retrying until `timeout_secs`.",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
      "host": {
        "default": "127.0.0.1",
        "type": "string"
      },
      "port": {
        "default": 5719,
        "description": "The app's inspection port.",
        "format": "uint16",
        "maximum": 65535,
        "minimum": 0,
        "type": "integer"
      },
      "timeout_secs": {
        "default": null,
        "description": "How long to keep retrying, in seconds. Defaults to 10.",
        "format": "uint64",
        "minimum": 0,
        "type": [
          "integer",
          "null"
        ]
      }
    },
    "type": "object"
  },
  "annotations": {
    "readOnlyHint": false,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
  }
}

## batch

{
  "name": "batch",
  "title": "Batch",
  "description": "Run app-driving tool calls in order in one round trip, stopping at the first error.\nEach step returns one JSON text item, then any images it produced.\nNot for `attach`, `disconnect`, `status` or a nested `batch`.",
  "inputSchema": {
    "$defs": {
      "BatchAction": {
        "properties": {
          "args": {
            "additionalProperties": true,
            "default": null,
            "type": "object"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
      "actions": {
        "items": {
          "$ref": "#/$defs/BatchAction"
        },
        "type": "array"
      }
    },
    "required": [
      "actions"
    ],
    "type": "object"
  },
  "annotations": {
    "readOnlyHint": false,
    "destructiveHint": true,
    "idempotentHint": false,
    "openWorldHint": false
  }
}

## click

{
  "name": "click",
  "title": "Click",
  "description": "Click the center of a widget, or a raw `pos`.",
  "inputSchema": {
    "$defs": {
      "Id": {
        "description": "A widget `id` from `widget_tree`.",
        "pattern": "^[0-9a-fA-F]{1,16}$",
        "type": "string"
      },
      "PointerButtonArg": {
        "description": "Also accepts `left` and `right`.",
        "enum": [
          "primary",
          "secondary",
          "middle",
          "extra1",
          "extra2"
        ],
        "type": "string"
      },
      "Pos2Lit": {
        "properties": {
          "x": {
            "format": "float",
            "type": "number"
          },
          "y": {
            "format": "float",
            "type": "number"
          }
        },
        "required": [
          "x",
          "y"
        ],
        "type": "object"
      },
      "PressKeyModifiers": {
        "properties": {
          "alt": {
            "default": false,
            "type": "boolean"
          },
          "command": {
            "default": false,
            "description": "Cmd on Mac, Ctrl elsewhere.",
            "type": "boolean"
          },
          "ctrl": {
            "default": false,
            "type": "boolean"
          },
          "mac_cmd": {
            "default": false,
            "type": "boolean"
          },
          "shift": {
            "default": false,
            "type": "boolean"
          }
        },
        "type": "object"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
      "button": {
        "$ref": "#/$defs/PointerButtonArg",
        "default": "primary"
      },
      "content_contains": {
        "description": "Case-insensitive substring of the widget's `label` or `value` (preferred).",
        "type": [
          "string",
          "null"
        ]
      },
      "count": {
        "default": 1,
        "description": "`2` → double-click; `3` → triple-click.",
        "format": "uint32",
        "minimum": 0,
        "type": "integer"
      },
      "id": {
        "anyOf": [
          {
            "$ref": "#/$defs/Id"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "label_contains": {
        "description": "Case-insensitive substring of the widget's `label` only.",
        "type": [
          "string",
          "null"
        ]
      },
      "modifiers": {
        "$ref": "#/$defs/PressKeyModifiers"
      },
      "pos": {
        "anyOf": [
          {
            "$ref": "#/$defs/Pos2Lit"
          },
          {
            "type": "null"
          }
        ],
        "description": "Raw position in logical points, instead of a widget."
      },
      "role": {
        "description": "Role name, e.g. `Button`, `Label`, `TextInput` (case-insensitive).",
        "type": [
          "string",
          "null"
        ]
      },
      "value_contains": {
        "description": "Case-insensitive substring of the widget's `value` only.",
        "type": [
          "string",
          "null"
        ]
      }
    },
    "type": "object"
  },
  "annotations": {
    "readOnlyHint": false,
    "destructiveHint": true,
    "idempotentHint": false,
    "openWorldHint": false
  }
}

