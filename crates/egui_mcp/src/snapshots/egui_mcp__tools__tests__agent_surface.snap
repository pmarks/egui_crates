## wait_for

{
  "name": "wait_for",
  "title": "Wait for widgets",
  "description": "Poll until at least `min_matches` visible widgets match the filter and `min_steps` frames have rendered, or until `timeout_secs`.\nNeeds a filter or a non-zero `min_steps`.",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
      "content_contains": {
        "description": "Case-insensitive substring of the widget's `label` or `value` (preferred).",
        "type": [
          "string",
          "null"
        ]
      },
      "label_contains": {
        "description": "Case-insensitive substring of the widget's `label` only.",
        "type": [
          "string",
          "null"
        ]
      },
      "min_matches": {
        "default": 1,
        "format": "uint32",
        "minimum": 0,
        "type": "integer"
      },
      "min_steps": {
        "default": 0,
        "description": "Frames to let render after the call begins, e.g. for a tooltip or animation to settle.",
        "format": "uint64",
        "minimum": 0,
        "type": "integer"
      },
      "role": {
        "description": "Role name, e.g. `Button`, `Label`, `TextInput` (case-insensitive).",
        "type": [
          "string",
          "null"
        ]
      },
      "timeout_secs": {
        "default": 5,
        "format": "uint64",
        "minimum": 0,
        "type": "integer"
      },
      "value_contains": {
        "description": "Case-insensitive substring of the widget's `value` only.",
        "type": [
          "string",
          "null"
        ]
      }
    },
    "type": "object"
  },
  "annotations": {
    "readOnlyHint": true,
    "openWorldHint": false
  }
}

## widget_tree

{
  "name": "widget_tree",
  "title": "Widget tree",
  "description": "List the widgets matching the filter, nested by ancestry: `children` holds the matches below a widget, not only its direct children.\nAbridged: no `bounds`, and a `label` or `value` over 100 characters is cut short with a trailing ` […]` (filters still match the full text). `get_widget` returns one widget in full.",
  "inputSchema": {
    "$defs": {
      "Exclusion": {
        "properties": {
          "content_contains": {
            "description": "Case-insensitive substring of the widget's `label` or `value` (preferred).",
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "anyOf": [
              {
                "$ref": "#/$defs/Id"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "label_contains": {
            "description": "Case-insensitive substring of the widget's `label` only.",
            "type": [
              "string",
              "null"
            ]
          },
          "role": {
            "description": "Role name, e.g. `Button`, `Label`, `TextInput` (case-insensitive).",
            "type": [
              "string",
              "null"
            ]
          },
          "value_contains": {
            "description": "Case-insensitive substring of the widget's `value` only.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "Id": {
        "description": "A widget `id` from `widget_tree`.",
        "pattern": "^[0-9a-fA-F]{1,16}$",
        "type": "string"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
      "content_contains": {
        "description": "Case-insensitive substring of the widget's `label` or `value` (preferred).",
        "type": [
          "string",
          "null"
        ]
      },
      "exclude": {
        "anyOf": [
          {
            "$ref": "#/$defs/Exclusion"
          },
          {
            "type": "null"
          }
        ],
        "description": "Leave out a subtree, by `id` or by the constraints the filter takes, e.g. a panel whose\ntext would otherwise answer every query."
      },
      "label_contains": {
        "description": "Case-insensitive substring of the widget's `label` only.",
        "type": [
          "string",
          "null"
        ]
      },
      "limit": {
        "default": 200,
        "description": "Most widgets to return. The deepest levels are cut first, and a widget that lost\nchildren reports how many in `omitted_children`.",
        "format": "uint",
        "minimum": 0,
        "type": "integer"
      },
      "role": {
        "description": "Role name, e.g. `Button`, `Label`, `TextInput` (case-insensitive).",
        "type": [
          "string",
          "null"
        ]
      },
      "root": {
        "anyOf": [
          {
            "$ref": "#/$defs/Id"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Walk only this widget's subtree, e.g. one that reported `omitted_children`."
      },
      "value_contains": {
        "description": "Case-insensitive substring of the widget's `value` only.",
        "type": [
          "string",
          "null"
        ]
      },
      "visible_only": {
        "default": true,
        "description": "Skip widgets egui reports as hidden: scrolled out of view, or in a collapsed section.",
        "type": "boolean"
      }
    },
    "type": "object"
  },
  "outputSchema": {
    "$defs": {
      "Id": {
        "description": "A widget `id` from `widget_tree`.",
        "pattern": "^[0-9a-fA-F]{1,16}$",
        "type": "string"
      },
      "Widget": {
        "description": "A widget in `widget_tree`'s result.",
        "properties": {
          "children": {
            "items": {
              "$ref": "#/$defs/Widget"
            },
            "type": "array"
          },
          "disabled": {
            "type": "boolean"
          },
          "focused": {
            "type": "boolean"
          },
          "hidden": {
            "type": "boolean"
          },
          "id": {
            "$ref": "#/$defs/Id"
          },
          "label": {
            "type": [
              "string",
              "null"
            ]
          },
          "omitted_children": {
            "description": "How many children `limit` left out; pass this widget's `id` as `root` to see them.",
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          },
          "role": {
            "description": "Absent for a role of `Unknown`.",
            "type": [
              "string",
              "null"
            ]
          },
          "value": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id"
        ],
        "type": "object"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
      "nodes": {
        "items": {
          "$ref": "#/$defs/Widget"
        },
        "type": "array"
      }
    },
    "required": [
      "nodes"
    ],
    "type": "object"
  },
  "annotations": {
    "readOnlyHint": true,
    "openWorldHint": false
  }
}
