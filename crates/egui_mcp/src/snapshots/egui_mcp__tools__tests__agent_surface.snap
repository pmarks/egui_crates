## get_widget

{
  "name": "get_widget",
  "title": "Widget details",
  "description": "One widget in full: its `bounds` in logical points (`click` lands on their center), `parent_id`, state, and uncut `label`/`value`.",
  "inputSchema": {
    "$defs": {
      "Id": {
        "description": "A widget `id` from `widget_tree`.",
        "pattern": "^[0-9a-fA-F]{1,16}$",
        "type": "string"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
      "id": {
        "$ref": "#/$defs/Id"
      }
    },
    "required": [
      "id"
    ],
    "type": "object"
  },
  "outputSchema": {
    "$defs": {
      "Id": {
        "description": "A widget `id` from `widget_tree`.",
        "pattern": "^[0-9a-fA-F]{1,16}$",
        "type": "string"
      },
      "RectF": {
        "properties": {
          "h": {
            "format": "double",
            "type": "number"
          },
          "w": {
            "format": "double",
            "type": "number"
          },
          "x": {
            "format": "double",
            "type": "number"
          },
          "y": {
            "format": "double",
            "type": "number"
          }
        },
        "required": [
          "x",
          "y",
          "w",
          "h"
        ],
        "type": "object"
      },
      "WidgetDetail": {
        "properties": {
          "bounds": {
            "anyOf": [
              {
                "$ref": "#/$defs/RectF"
              },
              {
                "type": "null"
              }
            ]
          },
          "disabled": {
            "type": "boolean"
          },
          "focused": {
            "type": "boolean"
          },
          "hidden": {
            "type": "boolean"
          },
          "id": {
            "$ref": "#/$defs/Id"
          },
          "label": {
            "type": [
              "string",
              "null"
            ]
          },
          "parent_id": {
            "anyOf": [
              {
                "$ref": "#/$defs/Id"
              },
              {
                "type": "null"
              }
            ]
          },
          "role": {
            "type": "string"
          },
          "value": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "role",
          "focused",
          "disabled",
          "hidden"
        ],
        "type": "object"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
      "node": {
        "anyOf": [
          {
            "$ref": "#/$defs/WidgetDetail"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "type": "object"
  },
  "annotations": {
    "readOnlyHint": true,
    "openWorldHint": false
  }
}

