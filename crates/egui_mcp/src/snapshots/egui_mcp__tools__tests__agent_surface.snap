## screenshot

{
  "name": "screenshot",
  "title": "Screenshot",
  "description": "Capture the current frame as a PNG.\nNeeds a visible window: a fully covered or minimized one renders no frame (notably on macOS), so the call times out.",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
      "pixels_per_point": {
        "default": 1.0,
        "description": "Higher is sharper, up to the display's native scale; the default of 1 lines pixels up\nwith logical points.",
        "format": "float",
        "type": "number"
      },
      "save_path": {
        "default": null,
        "description": "Also write the PNG to this path, on the machine running the MCP server.",
        "type": [
          "string",
          "null"
        ]
      }
    },
    "type": "object"
  },
  "annotations": {
    "readOnlyHint": false,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
  }
}

